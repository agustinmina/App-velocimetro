name: Build APK

on:
  push:
    branches:
      - main
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - name: Descargar código
        uses: actions/checkout@v4

      - name: Configurar Java 17
        uses: actions/setup-java@v4
        with:
          distribution: 'temurin'
          java-version: '17'

      - name: Configurar Node.js
        uses: actions/setup-node@v4
        with:
          node-version: '20'

      - name: Instalar Cordova
        run: npm install -g cordova

      - name: Compilar proyecto
        run: |
          cordova create app com.velocimetro.moto VelocimetroMoto
          rm -rf app/www/*
          cp index.html style.css app.js app/www/
          cd app
          
          # Forzar los permisos directamente en el archivo de configuración nativo
          cat << 'EOF' > config.xml
          <?xml version='1.0' encoding='utf-8'?>
          <widget id="com.velocimetro.moto" version="1.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:android="http://schemas.android.com/apk/res/android">
              <name>VelocimetroMoto</name>
              <description>Velocimetro Moto</description>
              <content src="index.html" />
              <platform name="android">
                  <config-file target="AndroidManifest.xml" parent="/*">
                      <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
                      <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
                      <uses-feature android:name="android.hardware.location.gps" />
                  </config-file>
              </platform>
          </widget>
          EOF
          
          cordova plugin add cordova-plugin-geolocation
          cordova platform add android
          cordova build android

      - name: Subir el APK terminado
        uses: actions/upload-artifact@v4
        with:
          name: Velocimetro-APK
          path: app/platforms/android/app/build/outputs/apk/debug/app-debug.apk
